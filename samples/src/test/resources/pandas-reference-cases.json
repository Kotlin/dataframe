[
  {"id": "shape", "pandas": "list(df.shape)", "expect": [6, 6]},
  {"id": "columnNames", "pandas": "list(df.columns)", "expect": ["region", "product", "year", "revenue", "cost", "discount"]},
  {"id": "headTwo", "pandas": "list(df.head(2).revenue)", "expect": [100, 150]},
  {"id": "tailTwo", "pandas": "list(df.tail(2).revenue)", "expect": [120, 90]},
  {"id": "filterTwoConditions", "pandas": "len(df[(df.revenue > 100) & (df.region == 'North')])", "expect": 2},
  {"id": "sortByDescending", "pandas": "list(df.sort_values('revenue', ascending=False).revenue)", "expect": [200, 150, 120, 100, 90, 80]},
  {"id": "sortByTwoColumns", "pandas": "list(df.sort_values(['year', 'revenue']).revenue)", "expect": [80, 100, 150, 90, 120, 200]},
  {"id": "dropFirstRows", "pandas": "len(df.iloc[4:])", "expect": 2},
  {"id": "firstRow", "pandas": "int(df.iloc[0].revenue)", "expect": 100},
  {"id": "iterateRows", "pandas": "[int(r.revenue) for r in df.itertuples()]", "expect": [100, 150, 80, 200, 120, 90]},
  {"id": "countMissing", "pandas": "int(df.discount.isna().sum())", "expect": 2},
  {"id": "dropMissingRows", "pandas": "len(df.dropna(subset=['discount']))", "expect": 4},
  {"id": "fillMissingValues", "pandas": "list(df.fillna({'discount': 0.0}).discount)", "expect": [0.1, 0.0, 0.05, 0.0, 0.2, 0.0]},
  {"id": "describeNullsOfDiscount", "pandas": "int(df.isnull().sum()['discount'])", "expect": 2},
  {"id": "distinctCount", "pandas": "int(df.region.nunique())", "expect": 2},
  {"id": "distinctValues", "pandas": "list(df.region.unique())", "expect": ["North", "South"]},
  {"id": "valueCounts", "pandas": "sorted(df.region.value_counts())", "expect": [3, 3]},
  {"id": "groupSum", "pandas": "list(df.groupby('region').revenue.sum())", "expect": [370, 370]},
  {"id": "groupCount", "pandas": "list(df.groupby('region').size())", "expect": [3, 3]},
  {"id": "pivotValues", "pandas": "df.pivot_table(values='revenue', index='region', columns='year', aggfunc='sum').values.tolist()", "expect": [[250, 120], [80, 290]]},
  {"id": "innerJoinRowCount", "pandas": "len(df.merge(managers, on='region'))", "expect": 6},
  {"id": "leftJoinRowCount", "pandas": "len(managers.merge(df, on='region', how='left'))", "expect": 7},
  {"id": "concatRowCount", "pandas": "len(pd.concat([df, df]))", "expect": 12},
  {"id": "mean", "pandas": "float(df.revenue.mean())", "expect": 123.33333333333333},
  {"id": "median", "pandas": "float(df.revenue.median())", "expect": 110.0},

  {"id": "percentile25", "pandas": "float(df.revenue.quantile(0.25))", "expect": 92.5, "expectKotlin": 89.16666666666666,
   "note": "same data, different percentile result"},
  {"id": "describeCoversColumns", "pandas": "list(df.describe().columns)", "expect": ["year", "revenue", "cost", "discount"],
   "expectKotlin": ["region", "product", "year", "revenue", "cost", "discount"],
   "note": "pandas describes the numeric columns; Kotlin DataFrame describes every column"},
  {"id": "groupOrderTwoKeys", "pandas": "list(df.groupby(['region', 'product']).revenue.sum())", "expect": [150, 220, 200, 170], "expectKotlin": [220, 150, 170, 200],
   "note": "pandas sorts the groups by key; Kotlin DataFrame keeps first-appearance order"},
  {"id": "groupOrderSortFalse", "pandas": "list(df.groupby(['region', 'product'], sort=False).revenue.sum())", "expect": [220, 150, 170, 200],
   "note": "groupby(sort=False) gives the order Kotlin DataFrame always uses"},

  {"id": "readParquetRows", "pandas": "len(pd.read_parquet(RES + 'sales-pandas.parquet'))", "expect": 6},
  {"id": "readParquetColumns", "pandas": "list(pd.read_parquet(RES + 'sales-pandas.parquet').columns)", "expect": ["region", "product", "year", "revenue", "cost", "discount"]},
  {"id": "readParquetSum", "pandas": "int(pd.read_parquet(RES + 'sales-pandas.parquet').revenue.sum())", "expect": 740},
  {"id": "readParquetMissing", "pandas": "int(pd.read_parquet(RES + 'sales-pandas.parquet').discount.isna().sum())", "expect": 2},
  {"id": "excelRoundTripRows", "pandas": "len(excel_roundtrip(df))", "expect": 6},
  {"id": "excelRoundTripColumns", "pandas": "list(excel_roundtrip(df).columns)", "expect": ["region", "product", "year", "revenue", "cost", "discount"]},
  {"id": "excelNumberTypes", "pandas": "[str(excel_roundtrip(df)[c].dtype) for c in ['year', 'revenue', 'cost', 'discount']]", "expect": ["int64", "int64", "int64", "float64"],
   "expectKotlin": ["kotlin.Double", "kotlin.Double", "kotlin.Double", "kotlin.Double?"],
   "note": "after an Excel round trip Pandas keeps whole numbers as int64; Kotlin DataFrame reads every number as Double"},

  {"id": "meltShape", "pandas": "(lambda m: [len(m), list(m.columns)])(df[['region', 'revenue', 'cost']].melt(id_vars=['region'], var_name='metric', value_name='amount'))", "expect": [12, ["region", "metric", "amount"]]},
  {"id": "meltOrder", "pandas": "list(df[['region', 'revenue', 'cost']].melt(id_vars=['region'], var_name='metric', value_name='amount').amount)", "expect": [100, 150, 80, 200, 120, 90, 60, 90, 70, 120, 70, 50],
   "expectKotlin": [100, 60, 150, 90, 80, 70, 200, 120, 120, 70, 90, 50],
   "note": "melt lists all values of the first column, then of the second; gather goes row by row"},
  {"id": "explodeValues", "pandas": "list(pd.DataFrame({'k': ['a', 'b'], 'v': [[1, 2], [3]]}).explode('v').v)", "expect": [1, 2, 3]},
  {"id": "splitValues", "pandas": "(lambda s: [list(s[0]), list(s[1])])(pd.Series(['a-b', 'c-d']).str.split('-', expand=True))", "expect": [["a", "c"], ["b", "d"]]},
  {"id": "concatColumns", "pandas": "list(pd.concat([df[['region']], df[['cost']]], axis=1).columns)", "expect": ["region", "cost"]},
  {"id": "joinDifferentKeyNamesRows", "pandas": "len(df.merge(managers.rename(columns={'region': 'area'}), left_on='region', right_on='area'))", "expect": 6},
  {"id": "joinDifferentKeyNamesColumns", "pandas": "list(df.merge(managers.rename(columns={'region': 'area'}), left_on='region', right_on='area').columns)",
   "expect": ["region", "product", "year", "revenue", "cost", "discount", "area", "manager"],
   "expectKotlin": ["region", "product", "year", "revenue", "cost", "discount", "manager"],
   "note": "merge(left_on, right_on) keeps both key columns; join { a match right.b } keeps only the left one"},

  {"id": "cumulativeSum", "pandas": "list(df.revenue.cumsum())", "expect": [100, 250, 330, 530, 650, 740]},
  {"id": "shiftByOne", "pandas": "list(df.revenue.shift(1))", "expect": [null, 100, 150, 80, 200, 120]},
  {"id": "diffFromPrevious", "pandas": "list(df.revenue.diff().fillna(0))", "expect": [0, 50, -70, 120, -80, -30]},
  {"id": "valueCountsNormalized", "pandas": "list(df.region.value_counts(normalize=True))", "expect": [0.5, 0.5]},
  {"id": "nLargest", "pandas": "list(df.nlargest(2, 'revenue').revenue)", "expect": [200, 150]},
  {"id": "nSmallest", "pandas": "list(df.nsmallest(2, 'revenue').revenue)", "expect": [80, 90]},
  {"id": "sampleCount", "pandas": "len(df.sample(3, random_state=0))", "expect": 3},

  {"id": "stringUpper", "pandas": "list(df.region.str.upper())", "expect": ["NORTH", "NORTH", "SOUTH", "SOUTH", "NORTH", "SOUTH"]},
  {"id": "stringContains", "pandas": "int(df.region.str.contains('or').sum())", "expect": 3},
  {"id": "stringLength", "pandas": "list(df.region.str.len())", "expect": [5, 5, 5, 5, 5, 5]},
  {"id": "rowWise", "pandas": "list(df.apply(lambda r: r.revenue - r.cost, axis=1))", "expect": [40, 60, 10, 80, 50, 40]},
  {"id": "dateYear", "pandas": "list(pd.to_datetime(pd.Series(['2023-01-15', '2024-03-02'])).dt.year)", "expect": [2023, 2024]},
  {"id": "groupTransform", "pandas": "list(df.groupby('region').cost.transform('sum'))", "expect": [220, 220, 240, 240, 220, 240]}
